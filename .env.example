# Copia este archivo como .env si quieres cambiar algo. Si no existe .env, se usan estos mismos valores por defecto.
BASE_URL=https://www.saucedemo.com
# chromium | firefox | webkit
BROWSER=chromium
HEADLESS=true
# Milisegundos de pausa entre acciones; útil solo para ver el test en modo headed
SLOW_MO=0
PARALLEL=2
# Guarda un trace de Playwright cuando un escenario falla (se abre con: npx playwright show-trace <archivo>)
TRACE_ON_FAILURE=true
# Contraseña compartida por todos los usuarios de Sauce Demo
SAUCE_PASSWORD=secret_sauce
